# Copia a `.dev.vars` (gitignored) para `wrangler dev` local.
# En producción estos NO van aquí: se cargan con `wrangler secret put GEMINI_API_KEY`
# y `wrangler secret put APP_SHARED_TOKEN`.

# Clave de la API de Gemini (Google AI Studio -> Get API key). ES EL SECRETO REAL.
GEMINI_API_KEY=

# Token compartido que exige el endpoint. Inventa uno largo y aleatorio; debe
# coincidir con VITE_LLM_PROXY_TOKEN en el .env del cliente.
APP_SHARED_TOKEN= 
