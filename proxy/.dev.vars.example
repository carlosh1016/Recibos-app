# Copia a `.dev.vars` (gitignored) para `wrangler dev` local.
# En producción estos NO van aquí: se cargan con `wrangler secret put GEMINI_API_KEY`,
# `wrangler secret put APP_PASSWORD` y `wrangler secret put APP_AUTH_SECRET`.

# Clave de la API de Gemini (Google AI Studio -> Get API key). ES EL SECRETO REAL.
GEMINI_API_KEY=

# Contraseña compartida que /login exige para dejar entrar a la app.
APP_PASSWORD=

# String aleatorio largo (ej. `openssl rand -hex 32`) usado para firmar el
# token de sesión (HMAC-SHA256). No es la contraseña; rotarlo invalida todos
# los tokens ya emitidos sin tener que cambiar APP_PASSWORD.
APP_AUTH_SECRET=
