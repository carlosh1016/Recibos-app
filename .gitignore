# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local

# Assets de OCR (~22MB): se regeneran con `npm run setup:ocr`, ver
# scripts/setup-ocr-assets.mjs. No se versionan porque son binarios grandes
# reproducibles desde node_modules + una descarga, no código.
public/tesseract/

# Variables de entorno locales: .env.local trae la clave REAL de OpenRouter
# para `pnpm run dev`. NUNCA versionar (la .env.example SÍ se versiona).
.env
.env.*
!.env.example

# Restos del antiguo proxy de Cloudflare (proxy/, ya sin uso): .dev.vars puede
# traer la clave REAL de Gemini. Se mantienen ignorados hasta borrar la carpeta.
proxy/.dev.vars
proxy/node_modules
proxy/.wrangler

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.claude/settings.local.json
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
