# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local

# Assets de OCR (~22MB): se regeneran con `npm run setup:ocr`, ver
# scripts/setup-ocr-assets.mjs. No se versionan porque son binarios grandes
# reproducibles desde node_modules + una descarga, no código.
public/tesseract/

# Variables de entorno locales del cliente (la .env.example SÍ se versiona).
# No contienen secretos fuertes, pero se ignoran por higiene.
.env
.env.*
!.env.example

# Secretos locales del proxy: .dev.vars trae la clave REAL de Gemini para
# `wrangler dev`. NUNCA versionar (ver proxy/.dev.vars.example).
proxy/.dev.vars
proxy/node_modules

