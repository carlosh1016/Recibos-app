# Secretos del SERVIDOR (las funciones de api/) para desarrollo local. Copia
# este archivo a `.env.local` (gitignored) y rellénalo: `pnpm run dev` los lee
# y los usa al servir /api/login y /api/extract (ver el plugin apiLocal en
# vite.config.ts). En producción NO van en ningún archivo: se cargan como
# variables de entorno del proyecto en Vercel.
#
# Ninguna lleva el prefijo VITE_ a propósito: así Vite nunca las mete en el
# bundle del navegador.

# Clave de OpenRouter (https://openrouter.ai/keys). ES EL SECRETO REAL: con
# ella se paga cada extracción.
OPENROUTER_API_KEY=

# Opcional: modelo de visión a usar. Por defecto google/gemini-2.5-flash-lite.
# Cambiarlo no requiere tocar código (ej. google/gemini-3.1-flash-lite).
OPENROUTER_MODEL=

# Contraseña compartida que /api/login exige para dejar entrar a la app.
APP_PASSWORD=

# String aleatorio largo (ej. `openssl rand -hex 32`) usado para firmar el
# token de sesión (HMAC-SHA256). No es la contraseña; rotarlo invalida todos
# los tokens ya emitidos sin tener que cambiar APP_PASSWORD.
APP_AUTH_SECRET=
