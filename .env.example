# Copia este archivo a `.env` y rellena los valores para habilitar la ruta LLM
# (extracción con Gemini). Si los dejas vacíos, la app funciona igual usando
# solo el OCR offline de Tesseract.
#
# NINGUNO de estos es la clave de Gemini: esa vive SOLO en el servidor (la
# función api/extract.ts en Vercel, o el Worker de Cloudflare en local).
# Estas variables van al bundle del cliente, así que trátalas como públicas.

# URL del endpoint del proxy. DÉJALA VACÍA en producción (Vercel): el cliente
# usa por defecto '/api/extract' en el mismo dominio (la función serverless).
# En local, para usar el Worker de Cloudflare con `wrangler dev`, ponla en:
#   VITE_LLM_PROXY_URL=http://localhost:8787
VITE_LLM_PROXY_URL=

# Token compartido que el endpoint exige en el header Authorization. Debe
# coincidir con APP_SHARED_TOKEN configurado en el servidor (variable de entorno
# de Vercel en producción, o proxy/.dev.vars en local).
VITE_LLM_PROXY_TOKEN=
