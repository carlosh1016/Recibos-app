# Copia este archivo a `.env` y rellena los valores para habilitar la ruta LLM
# (extracción con Gemini vía proxy). Si los dejas vacíos, la app funciona igual
# usando solo el OCR offline de Tesseract.
#
# NINGUNO de estos es la clave de Gemini: esa vive SOLO en el proxy serverless
# (ver proxy/README.md). Estas variables van al bundle del cliente, así que
# trátalas como públicas.

# URL del endpoint del proxy, ej. https://recibos-proxy.tu-usuario.workers.dev/extract
VITE_LLM_PROXY_URL=

# Token compartido que el proxy exige en el header Authorization. Debe coincidir
# con APP_SHARED_TOKEN configurado en el proxy.
VITE_LLM_PROXY_TOKEN=
